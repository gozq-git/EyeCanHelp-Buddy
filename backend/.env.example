AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Required by orchestrator runtime
AWS_KNOWLEDGE_BASE_ID=kb-xxxxxxxxxx

# Required for Bedrock ApplyGuardrail input screening on general enquiry
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
# Optional override; falls back to AWS_REGION/AWS_DEFAULT_REGION
BEDROCK_GUARDRAIL_REGION=

# Coordinator runtime endpoint used by backend/services/llm_service.py
AGENTCORE_COORDINATOR_ENDPOINT=http://127.0.0.1:8080/invocations
AGENTCORE_TIMEOUT_SECONDS=30

# Preferred for AWS InvokeAgentRuntime flow
AGENTCORE_COORDINATOR_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/coordinator-runtime-id
# Optional fixed session ID (if unset, backend generates one per request)
AGENTCORE_RUNTIME_SESSION_ID=

# Notification delivery (backend -> Gmail API)
GMAIL_SENDER_EMAIL=eyecanhelpbuddy@gmail.com
GMAIL_DESTINATION_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token

# Local database defaults for docker-compose development
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/eyecanhelpbuddy

# Optional: skip automatic DB schema and seed initialization on startup
# SKIP_DB_INIT=0
